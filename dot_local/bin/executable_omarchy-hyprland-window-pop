#!/usr/bin/env bash
# Float, size, position, and pin the current window; repeat to return it to tiling.
# Usage: omarchy-hyprland-window-pop [width height [x y]]
set -euo pipefail
[[ $# -le 4 ]] || { printf 'Expected at most four numeric arguments\n' >&2; exit 2; }
width=${1:-1300}
height=${2:-900}
x=${3:-0}
y=${4:-0}
[[ $width =~ ^[1-9][0-9]*$ && $height =~ ^[1-9][0-9]*$ && $x =~ ^-?[0-9]+$ && $y =~ ^-?[0-9]+$ ]] || exit 2
active=$(hyprctl activewindow -j)
address=$(jq -er '.address // empty' <<<"$active") || exit 0
[[ $address =~ ^0x[0-9a-fA-F]+$ ]] || exit 1
pinned=$(jq -r '.pinned' <<<"$active")
request() {
    local response
    response=$(hyprctl dispatch "$1")
    [[ $response == ok ]] || { printf '%s\n' "$response" >&2; exit 1; }
}
if [[ $pinned == true ]]; then
    request "hl.dsp.window.pin({ window = \"address:$address\" })"
    request "hl.dsp.window.float({ window = \"address:$address\", action = \"toggle\" })"
    request "hl.dsp.window.tag({ window = \"address:$address\", tag = \"-pop\" })"
else
    request "hl.dsp.window.float({ window = \"address:$address\", action = \"toggle\" })"
    request "hl.dsp.window.resize({ window = \"address:$address\", x = $width, y = $height, relative = false })"
    if [[ $# == 4 ]]; then
        request "hl.dsp.window.move({ window = \"address:$address\", x = $x, y = $y, relative = true })"
    else
        request "hl.dsp.window.center({ window = \"address:$address\" })"
    fi
    request "hl.dsp.window.pin({ window = \"address:$address\" })"
    request "hl.dsp.window.alter_zorder({ window = \"address:$address\", mode = \"top\" })"
    request "hl.dsp.window.tag({ window = \"address:$address\", tag = \"+pop\" })"
fi
