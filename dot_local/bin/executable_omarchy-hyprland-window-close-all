#!/usr/bin/env bash
# Close every window gracefully, then focus workspace 1.
set -euo pipefail
clients=$(hyprctl clients -j)
addresses=$(jq -r '[.[].address] | if all(.[]; test("^0x[0-9a-fA-F]+$")) then .[] else error("Invalid window address") end' <<<"$clients")
while IFS= read -r address; do
    [[ -n $address ]] || continue
    response=$(hyprctl dispatch "hl.dsp.window.close({ window = \"address:$address\" })")
    [[ $response == ok ]] || { printf '%s\n' "$response" >&2; exit 1; }
done <<<"$addresses"
response=$(hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })')
[[ $response == ok ]] || { printf '%s\n' "$response" >&2; exit 1; }
