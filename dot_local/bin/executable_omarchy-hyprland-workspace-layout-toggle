#!/usr/bin/env bash
# Toggle the active workspace layout using Hyprland's native Lua API.
set -euo pipefail
workspace=$(hyprctl activeworkspace -j)
id=$(jq -er '.id | select(type == "number")' <<<"$workspace")
[[ $id =~ ^-?[0-9]+$ ]] || exit 1
selector=$(jq -er '
    (if .id > 0 then (.id | tostring) else
        .name | if startswith("special:") then . else "name:" + . end
    end) | if (explode | any(. < 32 or . == 127)) then error("Invalid workspace name") else @json end
' <<<"$workspace")
layout=$(jq -r '.tiledLayout' <<<"$workspace")
if [[ $layout == dwindle ]]; then next=scrolling; else next=dwindle; fi
response=$(hyprctl eval "hl.workspace_rule({ workspace = $selector, layout = \"$next\" })")
[[ $response == ok ]] || { printf '%s\n' "$response" >&2; exit 1; }
notify-send "Workspace layout set to $next"
