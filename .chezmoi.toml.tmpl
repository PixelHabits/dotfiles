{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi "osRelease" -}}
{{-   if hasKey .chezmoi.osRelease "id" -}}
{{-     $osid = .chezmoi.osRelease.id -}}
{{-   end -}}
{{- end -}}

{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $desktop := promptStringOnce . "desktop" "Desktop environment (hyprland/none)" -}}
{{- $formFactor := promptStringOnce . "form_factor" "Machine form factor (laptop/desktop/server)" -}}
{{- $profile := promptStringOnce . "profile" "Machine profile (work/personal)" -}}
{{- $dev := promptBoolOnce . "dev" "Development machine" -}}

{{- $pwa := (include ".chezmoidata/pwa.toml" | fromToml).pwa -}}
{{- $mailChoices := list -}}
{{- range $name, $_ := $pwa.mailProviders -}}
{{- $mailChoices = append $mailChoices $name -}}
{{- end -}}
{{- $mailProvider := get . "mail_provider" | default (get $pwa.mailDefaults $profile) -}}
{{- $linearURL := get . "linear_url" | default (get $pwa.linearDefaults $profile) -}}
{{- if eq $desktop "hyprland" -}}
{{- $mailProvider = promptChoiceOnce . "mail_provider" "Mail provider" $mailChoices $mailProvider -}}
{{- $linearURL = promptStringOnce . "linear_url" "Linear landing URL" $linearURL -}}
{{- end -}}

# Keep the worktree selected by --source when this file is regenerated.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  osid = {{ $osid | quote }}
  hostname = {{ .chezmoi.hostname | quote }}
  email = {{ $email | quote }}
  desktop = {{ $desktop | quote }}
  form_factor = {{ $formFactor | quote }}
  profile = {{ $profile | quote }}
  dev = {{ $dev }}
  mail_provider = {{ $mailProvider | quote }}
  linear_url = {{ $linearURL | quote }}

{{- if and (hasKey . "hyprland") (hasKey .hyprland "monitors") }}

{{ if eq (len .hyprland.monitors) 0 }}
[data.hyprland]
monitors = []
{{ end }}
{{ range .hyprland.monitors }}
{{ if not (kindIs "map" .) }}{{ fail "hyprland.monitors must contain tables; see hyprland.md" }}{{ end -}}
[[data.hyprland.monitors]]
{{ . | toToml }}{{ end }}
{{- end }}
