# ~/.zshenv (bootstrap only - managed by chezmoi)
# Zsh reads this file only when ZDOTDIR is unset.
# Only find ZDOTDIR here. The full .zshenv sets the XDG defaults.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

if [[ -r "$ZDOTDIR/.zshenv" ]]; then
  source "$ZDOTDIR/.zshenv"
fi
