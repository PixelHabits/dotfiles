# ~/.config/zsh/.zshenv
# Zsh enters here directly when ZDOTDIR is inherited, or through ~/.zshenv.

# Shared base defaults. Keep existing environment values.
{{ $env := includeTemplate "xdg-env.toml.tmpl" . | fromToml -}}
{{ range $name, $value := $env.base -}}
export {{ $name }}={{ printf "${%s:-%s}" $name ($value | shellQuote) }}
{{ end }}
# Helper to source numbered drop-ins.
source_dir() {
  for f in "$1"/*.zsh(N-.r); do
    source "$f"
  done
}

source_dir "$ZDOTDIR/zshenv.d"
