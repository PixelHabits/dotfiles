# Shared XDG app redirects. Keep existing environment values.
{{ $env := includeTemplate "xdg-env.toml.tmpl" . | fromToml -}}
{{ range $name, $value := omit $env "XDG_CONFIG_HOME" "XDG_CACHE_HOME" "XDG_DATA_HOME" "XDG_STATE_HOME" "ZDOTDIR" -}}
export {{ $name }}={{ printf "${%s:-%s}" $name ($value | shellQuote) }}
{{ end -}}
