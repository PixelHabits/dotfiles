export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-{{ $home }}/.local/state/claude}"
export CLAUDE_CODE_TMPDIR="${CLAUDE_CODE_TMPDIR:-{{ $home }}/.local/state/claude/tmp}"
export CLAUDE_CODE_SHELL="${CLAUDE_CODE_SHELL:-/bin/bash}"
