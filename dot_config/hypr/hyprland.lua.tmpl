-------------------

-- SUPER: core actions. SHIFT: movement/apps. CTRL: system. ALT: secondary actions.
local mainMod = "SUPER"

local function bind(keys, action, description, flags)
    flags = flags or {}
    flags.description = description
    hl.bind(keys, action, flags)
end

-- Hyprland shows error-level dispatch failures itself; warnings such as a refused pin are otherwise silent.
local function dispatch(action)
    local result = hl.dispatch(action)
    if not result.ok and result.level ~= "error" then
        hl.notification.create({ text = result.error, duration = 5000, icon = "warning" })
    end
    return result.ok
end

-- exec_cmd runs through /bin/sh.
local function quote(value)
    return "'" .. value:gsub("'", [['\'']]) .. "'"
end

local function screenshot(capture)
    return [[dir=${HYPRSHOT_DIR:-${XDG_PICTURES_DIR:-$(xdg-user-dir PICTURES || echo "$HOME")}}; ]]
        .. [[file=$dir/$(date +%Y-%m-%d-%H%M%S_hyprshot.png); mkdir -p "$dir" && grim ]] .. capture .. [[ "$file" && ]]
        .. [[wl-copy --type image/png < "$file" && notify-send "Screenshot saved" ]]
        .. [["Image saved in <i>$file</i> and copied to the clipboard." -t 5000 -i "$file" -a Screenshot]]
end

-- hyprpicker keeps the screen frozen until grim has captured it. A cancelled selection saves nothing.
local function selection(slurp)
    return [[hyprpicker -r -z & picker=$!; sleep 0.2; geometry=$(]] .. slurp .. [[); ]]
        .. [[if test -n "$geometry"; then ]] .. screenshot([[-g "$geometry"]]) .. [[; fi; kill "$picker"]]
end

-- Clipboard
bind(mainMod .. " + C", hl.dsp.send_shortcut({ mods = "CTRL", key = "Insert" }), "Universal copy")
bind(mainMod .. " + V", hl.dsp.send_shortcut({ mods = "SHIFT", key = "Insert" }), "Universal paste")
bind(mainMod .. " + X", hl.dsp.send_shortcut({ mods = "CTRL", key = "X" }), "Universal cut")

-- Windows
bind(mainMod .. " + W", hl.dsp.window.close(), "Close window")
bind(mainMod .. " + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }), "Fullscreen toggle")
bind(mainMod .. " + ALT + F", hl.dsp.window.fullscreen({ mode = "maximized" }), "Full width")
bind(mainMod .. " + T", hl.dsp.window.float({ action = "toggle" }), "Toggle floating/tiling")
bind(mainMod .. " + P", hl.dsp.window.pseudo(), "Pseudo (dwindle)")
bind(mainMod .. " + J", hl.dsp.layout("togglesplit"), "Toggle split (dwindle)")
bind(mainMod .. " + A", hl.dsp.window.pin(), "Pin window")
bind(mainMod .. " + O", function()
    local window = hl.get_active_window()
    if not window then return end
    local steps = window.pinned and {
        hl.dsp.window.pin({ action = "disable" }),
        hl.dsp.window.float({ action = "disable" }),
        hl.dsp.window.tag({ tag = "-pop" }),
    } or {
        hl.dsp.window.float({ action = "enable" }),
        hl.dsp.window.resize({ x = 1300, y = 900 }),
        hl.dsp.window.center(),
        hl.dsp.window.pin({ action = "enable" }),
        hl.dsp.window.alter_zorder({ mode = "top" }),
        hl.dsp.window.tag({ tag = "+pop" }),
    }
    for _, step in ipairs(steps) do
        if not dispatch(step) then return end
    end
end, "Pop window out (float & pin)")
bind(mainMod .. " + SHIFT + left", hl.dsp.window.swap({ direction = "left" }), "Swap window left")
bind(mainMod .. " + SHIFT + right", hl.dsp.window.swap({ direction = "right" }), "Swap window right")
bind(mainMod .. " + SHIFT + up", hl.dsp.window.swap({ direction = "up" }), "Swap window up")
bind(mainMod .. " + SHIFT + down", hl.dsp.window.swap({ direction = "down" }), "Swap window down")
bind(mainMod .. " + minus", hl.dsp.window.resize({ x = -100, y = 0, relative = true }), "Shrink window width")
bind(mainMod .. " + equal", hl.dsp.window.resize({ x = 100, y = 0, relative = true }), "Grow window width")
bind(mainMod .. " + SHIFT + minus", hl.dsp.window.resize({ x = 0, y = -100, relative = true }), "Shrink window height")
bind(mainMod .. " + SHIFT + equal", hl.dsp.window.resize({ x = 0, y = 100, relative = true }), "Grow window height")
bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), nil, { mouse = true })
bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), nil, { mouse = true })

