{{- /* chezmoi:modify-template */ -}}
{{- $settings := fromJson (default "{}" .chezmoi.stdin) -}}
{{- $refs := "~/.local/bin/refs hook claude" -}}
{{- $managed := dict
  "SessionStart" (dict "matcher" "startup|resume|clear|compact" "hooks" (list (dict "type" "command" "command" (printf "%s SessionStart" $refs) "timeout" 20)))
  "UserPromptSubmit" (dict "hooks" (list (dict "type" "command" "command" (printf "%s UserPromptSubmit" $refs) "timeout" 5)))
  "PostToolUse" (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" (printf "%s PostToolUse" $refs) "timeout" 5)))
-}}
{{- $hooks := get $settings "hooks" | default dict -}}
{{- range $event, $entry := $managed -}}
{{-   $kept := list -}}
{{-   range (get $hooks $event | default list) -}}
{{-     $group := . -}}
{{-     $foreign := list -}}
{{-     range (get . "hooks" | default list) -}}
{{-       if not (hasPrefix (printf "%s " $refs) (get . "command" | default "")) -}}
{{-         $foreign = append $foreign . -}}
{{-       end -}}
{{-     end -}}
{{-     if $foreign -}}
{{-       $kept = append $kept (set $group "hooks" $foreign) -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $hooks $event (append $kept $entry) -}}
{{- end -}}
{{- $_ := set $settings "hooks" $hooks -}}
{{- $settings
  | setValueAtPath "attribution.commit" ""
  | setValueAtPath "attribution.pr" ""
  | setValueAtPath "attribution.sessionUrl" false
  | toPrettyJson }}
