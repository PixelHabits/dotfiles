{{- $home := .chezmoi.homeDir -}}
service_tier = "fast"
model = "gpt-5.5"
model_reasoning_effort = "xhigh"
log_dir = "{{ $home }}/.local/state/codex/log"

[marketplaces.caveman-repo]
last_updated = "2026-05-20T15:12:20Z"
last_revision = "655b7d9c5431f822264b7732e9901c5578ac84cf"
source_type = "git"
source = "https://github.com/JuliusBrussee/caveman.git"

[plugins."caveman@caveman-repo"]
enabled = true

[features]
goals = true
terminal_resize_reflow = true
memories = true

[notice]
fast_default_opt_out = true

[mcp_servers.Bun]
url = "https://bun.com/docs/mcp"

[mcp_servers.Bun.tools.search_bun]
approval_mode = "approve"

[mcp_servers.chrome-devtools]
command = "bunx"
args = ["chrome-devtools-mcp@latest"]

[mcp_servers.chrome-devtools.env]
BUN_INSTALL = "{{ $home }}/.local/share/bun"
XDG_CACHE_HOME = "{{ $home }}/.cache"
XDG_CONFIG_HOME = "{{ $home }}/.config"
XDG_DATA_HOME = "{{ $home }}/.local/share"
XDG_STATE_HOME = "{{ $home }}/.local/state"
CODEX_HOME = "{{ $home }}/.config/codex"
CODEX_SQLITE_HOME = "{{ $home }}/.local/state/codex"
