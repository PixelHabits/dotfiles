{
  "description": "Tell Codex which local library checkouts exist and when they change.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/refs hook codex SessionStart",
            "timeout": 20,
            "statusMessage": "Loading references",
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/refs hook codex UserPromptSubmit",
            "timeout": 5,
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/refs hook codex PostToolUse",
            "timeout": 5,
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
